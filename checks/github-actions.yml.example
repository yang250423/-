name: Check reader

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  reader:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Check generated book, EPUB and local references
        run: python3 build.py --check
